# Local Maven cache — recreated by Maven after clone
**/.m2/
**/.m2.rar
*.rar

# Local JDK / Tika installs (too large for git; install separately)
jdk_21/
tika/

# Build outputs
**/target/
**/node_modules/

# Nested git metadata renamed while assembling this repo
**/.git.bak/

# Partial extract inside the split archive (the .z* / .zip volumes are the archive)
split_SWS/SWS/

# Zip volumes are published on the GitHub Release, not in git (GitHub HTTP 500 on a 4.4 GB push)
split_SWS/SWS.z*
split_SWS/SWS.zip
split_SWS/RELEASE_NOTES.md

# IDE / OS
.idea/
**/.idea/
*.iml
.classpath
.project
.settings/
*.log
.DS_Store
Thumbs.db
*.crdownload
